# Groq API Key (Primary LLM parser option selected)
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Alternative: Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Hugging Face Token for dataset/model operations
HF_TOKEN=hf_your_token_here
